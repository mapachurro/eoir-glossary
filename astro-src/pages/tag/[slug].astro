---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TermCard from "../../components/TermCard.astro";

import glossary from "../../../src/data/glossary.json";
import tags from "../../../src/data/tags.json";
import slugify from "../../../src/utils/slugify.js";

export function getStaticPaths() {
  return tags.map((tag) => ({
    params: { slug: tag.slug },
    props: {
      tag,
      matchingTerms: glossary.filter((term) =>
        (term.tags || []).some(
          (value) => slugify(value) === tag.slug,
        ),
      ),
    },
  }));
}

const { tag, matchingTerms } = Astro.props;
---

<BaseLayout
  title={`Tag: ${tag.label}`}
  description={`Browse immigration glossary terms tagged ${tag.label}.`}
>
  <section class="page">
    <h1>Tag: {tag.label}</h1>

    <p>
      {matchingTerms.length}
      {matchingTerms.length === 1 ? " term" : " terms"} shown.
    </p>

    <div class="term-list">
      {
        matchingTerms.map((term) => (
          <TermCard term={term} />
        ))
      }
    </div>
  </section>
</BaseLayout>