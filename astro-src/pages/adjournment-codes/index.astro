---
import BaseLayout from "../../layouts/BaseLayout.astro";
import codes from "../../../src/data/adjournmentCodes.json";

const categoryOrder = [
  "Respondent",
  "DHS",
  "Immigration Judge",
  "Court Administration",
  "Operational",
];

function sortCodes(a, b) {
  return a.code.localeCompare(b.code, undefined, {
    numeric: true,
    sensitivity: "base",
  });
}

function getClockClass(value) {
  const normalized = String(value || "").toLowerCase();

  if (normalized.includes("stop")) return "clock-badge clock-badge--stops";
  if (normalized.includes("run")) return "clock-badge clock-badge--runs";
  if (normalized.includes("neutral")) return "clock-badge clock-badge--neutral";

  return "clock-badge";
}

const groupedCodes = codes.reduce((groups, code) => {
  const category = code.category || "Uncategorized";
  (groups[category] ||= []).push(code);
  return groups;
}, {});

const sortedCategories = Object.keys(groupedCodes).sort((a, b) => {
  const indexA = categoryOrder.indexOf(a);
  const indexB = categoryOrder.indexOf(b);

  if (indexA === -1 && indexB === -1) return a.localeCompare(b);
  if (indexA === -1) return 1;
  if (indexB === -1) return -1;

  return indexA - indexB;
});

const searchableCodes = codes.map((code) => ({
  id: code.id || code.code,
  searchText: [
    code.id,
    code.code,
    code.meaning,
    code.spanishMeaning,
    code.category,
    code.affectsAsylumClock,
    code.notes,
    code.source,
    ...(code.relatedTerms || []),
  ]
    .join(" ")
    .toLowerCase(),
}));
---

<BaseLayout
  title="Adjournment Code Explorer"
  description="A bilingual reference guide to EOIR adjournment codes and their effects on the asylum EAD clock."
>
  <section class="page">
    <h1>Adjournment Code Explorer</h1>

    <p class="page-intro">
      A reference guide, fairly but not completely, complete and up-to-date, to
      the <strong>adjournment codes</strong> used in US Immigration Court (EOIR)
      proceedings.
    </p>

    <p>
      These codes embed information regarding the reason that the case is being
      continued to a later date into the record. They can affect the results of
      a case; they can affect other processes outside of the EOIR, most
      significantly the
      <a href="/terms/?q=asylum%20clock">asylum clock</a>, a timekeeping measure
      that determines when an asylum seeker present in the US is eligible to
      receive a work permit.
    </p>

    <input
      id="codes-search"
      type="search"
      placeholder="Search by code, meaning, category, clock effect..."
      aria-label="Search adjournment codes"
      autocomplete="off"
    />

    <p id="codes-count" class="results-count" aria-live="polite">
      {codes.length} {codes.length === 1 ? "code" : "codes"} shown.
    </p>

    <div id="codes-empty" class="empty-state" hidden>
      <h2>No matching codes found</h2>
      <p>Try another code, category, or keyword.</p>
    </div>

    {sortedCategories.map((category) => (
      <section class="code-category-section">
        <h2>{category} Adjournments</h2>

        <div class="code-table">
          <div class="code-table__header">
            <span>Code</span>
            <span>Meaning</span>
            <span>EAD Clock Effect</span>
          </div>

          {[...groupedCodes[category]].sort(sortCodes).map((code) => (
            <article class="code-row" data-code-id={code.id || code.code}>
              <div class="code-row__code">{code.code}</div>

              <div class="code-row__main">
                <h3>{code.meaning}</h3>

                {code.spanishMeaning && (
                  <p class="code-row__spanish">{code.spanishMeaning}</p>
                )}

                {code.notes && (
                  <p class="code-row__notes">
                    <strong>Notes:</strong> {code.notes}
                  </p>
                )}

                {code.relatedTerms?.length > 0 && (
                  <p class="code-row__related">
                    <strong>Related terms:</strong>{" "}
                    {code.relatedTerms.join(", ")}
                  </p>
                )}

                {code.source && (
                  <p class="code-row__source">
                    <a
                      href={code.source}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Source
                    </a>
                  </p>
                )}
              </div>

              <div>
                <span class={getClockClass(code.affectsAsylumClock)}>
                  {code.affectsAsylumClock || "—"}
                </span>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>

<script define:vars={{ searchableCodes }}>
  const input = document.querySelector("#codes-search");
  const count = document.querySelector("#codes-count");
  const empty = document.querySelector("#codes-empty");

  const rows = new Map(
    Array.from(document.querySelectorAll("[data-code-id]")).map((row) => [
      row.dataset.codeId,
      row,
    ]),
  );

  const sections = Array.from(
    document.querySelectorAll(".code-category-section"),
  );

  function filterCodes(query) {
    const normalized = query.trim().toLowerCase();
    let visible = 0;

    for (const code of searchableCodes) {
      const matches = !normalized || code.searchText.includes(normalized);

      const row = rows.get(code.id);

      if (row) row.hidden = !matches;
      if (matches) visible++;
    }

    for (const section of sections) {
      const hasVisibleRows = Array.from(
        section.querySelectorAll(".code-row"),
      ).some((row) => !row.hidden);

      section.hidden = !hasVisibleRows;
    }

    count.textContent = `${visible} ${visible === 1 ? "code" : "codes"} shown.`;
    empty.hidden = visible !== 0;

    const url = new URL(window.location.href);

    if (normalized) {
      url.searchParams.set("q", query);
    } else {
      url.searchParams.delete("q");
    }

    window.history.replaceState({}, "", url);
  }

  const params = new URLSearchParams(window.location.search);
  input.value = params.get("q") || "";

  filterCodes(input.value);

  input.addEventListener("input", () => {
    filterCodes(input.value);
  });

  window.addEventListener("popstate", () => {
    const params = new URLSearchParams(window.location.search);
    input.value = params.get("q") || "";
    filterCodes(input.value);
  });
</script>
