---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TermCard from "../../components/TermCard.astro";
import glossary from "../../../src/data/glossary.json";

const searchableTerms = glossary.map((term) => ({
  id: term.id,
  searchText: [
    term.english,
    term.englishDefinition,
    term.spanish,
    term.spanishDefinition,
    term.comments,
    term.proposals,
    ...(term.category || []),
    ...(term.tags || []),
    ...(term.aliases || []),
  ]
    .join(" ")
    .toLowerCase(),
}));
---

<BaseLayout
  title="All Terms"
  description="Browse and search English-Spanish immigration court terminology."
>
  <section class="page">
    <h1>All terms</h1>

    <p id="term-count">{glossary.length} terms shown.</p>

    <input
      id="term-search"
      type="search"
      placeholder="Search English, Spanish, comments, tags, aliases..."
      aria-label="Search glossary terms"
      autocomplete="off"
    />

    <div id="empty-state" class="empty-state" hidden>
      <h2>No matching terms found</h2>
      <p>
        Try a broader word, a different spelling, or search in English or
        Spanish.
      </p>
    </div>

    <div class="term-list" id="term-list">
      {
        glossary.map((term) => (
          <div class="term-result" data-term-id={term.id}>
            <TermCard term={term} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script define:vars={{ searchableTerms }}>
  const input = document.querySelector("#term-search");
  const count = document.querySelector("#term-count");
  const emptyState = document.querySelector("#empty-state");

  const elements = new Map(
    Array.from(document.querySelectorAll(".term-result")).map((element) => [
      element.dataset.termId,
      element,
    ])
  );

  function filterTerms(query) {
    const normalized = query.toLowerCase().trim();
    let visible = 0;

    for (const term of searchableTerms) {
      const matches =
        !normalized || term.searchText.includes(normalized);

      const element = elements.get(term.id);

      if (element) {
        element.hidden = !matches;
      }

      if (matches) visible++;
    }

    count.textContent = `${visible} ${visible === 1 ? "term" : "terms"} shown.`;
    emptyState.hidden = visible !== 0;

    const url = new URL(window.location.href);

    if (normalized) {
      url.searchParams.set("q", query);
    } else {
      url.searchParams.delete("q");
    }

    window.history.replaceState({}, "", url);
  }

  const params = new URLSearchParams(window.location.search);
  input.value = params.get("q") || "";

  filterTerms(input.value);

  input.addEventListener("input", () => {
    filterTerms(input.value);
  });

  window.addEventListener("popstate", () => {
    const params = new URLSearchParams(window.location.search);
    input.value = params.get("q") || "";
    filterTerms(input.value);
  });
</script>