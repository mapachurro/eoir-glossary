---
import Header from "../components/Header.astro";
import "../../src/styles.css";
import LegacyRedirect from "../components/LegacyRedirect.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Immigration Glossary • Glosario de lo migratorio",
  description = "A bilingual English-Spanish glossary of United States immigration terminology, forms, case law, and immigration court references.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
  (() => {
    const measurementId = "G-KSXCONFZLZ";
    const consentKey = "gringo-analytics-consent";

    window.getAnalyticsConsent = function () {
      return localStorage.getItem(consentKey);
    };

    function clearAnalyticsCookies() {
  const cookieNames = document.cookie
    .split(";")
    .map((cookie) => cookie.trim().split("=")[0])
    .filter((name) => name === "_ga" || name.startsWith("_ga_"));

  for (const name of cookieNames) {
    for (const domain of [
      undefined,
      location.hostname,
      "." + location.hostname,
      ".gringo.bingo"
    ]) {
      const domainAttribute = domain ? "; domain=" + domain : "";

      document.cookie =
        name +
        "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/" +
        domainAttribute;
    }
  }
}

    function loadAnalytics() {
  window["ga-disable-" + measurementId] = false;

  if (window.__analyticsLoaded) {
    window.gtag("consent", "update", {
      analytics_storage: "granted",
    });
    return;
  }

  window.__analyticsLoaded = true;
  window.dataLayer = window.dataLayer || [];

  window.gtag = function () {
    window.dataLayer.push(arguments);
  };

  window.gtag("consent", "default", {
    analytics_storage: "granted",
    ad_storage: "denied",
    ad_user_data: "denied",
    ad_personalization: "denied",
  });

  window.gtag("js", new Date());
  window.gtag("config", measurementId);

  const script = document.createElement("script");
  script.async = true;
  script.src =
    "https://www.googletagmanager.com/gtag/js?id=" +
    measurementId;

  document.head.appendChild(script);
}

    window.setAnalyticsConsent = function (choice) {
      if (choice !== "accepted" && choice !== "rejected") return;

      localStorage.setItem(consentKey, choice);

      if (choice === "accepted") {
        loadAnalytics();
      } else if (window.__analyticsLoaded) {
        window.gtag("consent", "update", {
          analytics_storage: "denied"
        });

        window["ga-disable-" + measurementId] = true;
        clearAnalyticsCookies();
      }

      document.dispatchEvent(
        new Event("analytics-consent-changed")
      );
    };

    if (window.getAnalyticsConsent() === "accepted") {
      loadAnalytics();
    }
  })();
</script>

    <meta charset="UTF-8" />
    <LegacyRedirect />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://gringo.bingo/social-card.png" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <div class="site-shell">
      <Header />

      <main class="site-main">
        <div class="container">
          <slot />
        </div>
      </main>
    </div>
    <AnalyticsConsent />
  </body>
</html>
